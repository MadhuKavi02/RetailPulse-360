   ],
   "source": [
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "# RetailPulse — KartZone India Pvt. Ltd.\n",
    "#  CUSTOMERS TABLE GENERATOR \n"
    "# ═══════════════════════════════════════════════════════════════════════════════\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "from datetime import datetime, timedelta\n",
    "import random\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "np.random.seed(42)\n",
    "random.seed(42)\n",
    "\n",
    "print(\"=\"*65)\n",
    "print(\"  KARTZONE INDIA — CUSTOMERS TABLE GENERATOR\")\n",
    "print(\"=\"*65)\n",
    "\n",
    "FIRST = ['Aarav','Aditya','Akash','Amit','Amrita','Ananya','Anjali','Arjun',\n",
    "         'Deepa','Deepak','Divya','Harish','Kavya','Kiran','Lakshmi','Manish',\n",
    "         'Meena','Mohan','Nisha','Pooja','Priya','Rahul','Ravi','Rekha',\n",
    "         'Rohit','Sandhya','Sanjay','Sneha','Suresh','Vikram','Vinay','Vishal',\n",
    "         'Priyanka','Sunita','Ajay','Vijay','Manoj','Neha','Shreya','Gaurav',\n",
    "         'Pallavi','Ramesh','Seema','Tarun','Uma','Varun','Yamini','Zara',\n",
    "         'Kartik','Ishaan','Riya','Isha','Tanvi','Yash','Neeraj','Sonal']\n",
    "\n",
    "LAST = ['Sharma','Verma','Patel','Gupta','Singh','Kumar','Iyer','Nair',\n",
    "        'Reddy','Rao','Joshi','Mehta','Shah','Malhotra','Kapoor','Agarwal',\n",
    "        'Mishra','Pandey','Tiwari','Dubey','Bose','Chatterjee','Das','Sen',\n",
    "        'Pillai','Menon','Krishnan','Subramaniam','Venkatesh','Naidu']\n",
    "\n",
    "CITY_STATE = {\n",
    "    'Mumbai':    ('Maharashtra','West'),\n",
    "    'Delhi':     ('Delhi','North'),\n",
    "    'Bangalore': ('Karnataka','South'),\n",
    "    'Chennai':   ('Tamil Nadu','South'),\n",
    "    'Hyderabad': ('Telangana','South'),\n",
    "    'Pune':      ('Maharashtra','West')\n",
    "}\n",
    "\n",
    "CITY_VARIANTS = {\n",
    "    'Mumbai':    ['Mumbai','mumbai','MUMBAI','Bombay','mumbai '],\n",
    "    'Delhi':     ['Delhi','delhi','New Delhi','NEW DELHI','Delhi '],\n",
    "    'Bangalore': ['Bangalore','bangalore','Bengaluru','BANGALORE','Banglore'],\n",
    "    'Chennai':   ['Chennai','chennai','CHENNAI','Madras','chennai '],\n",
    "    'Hyderabad': ['Hyderabad','hyderabad','HYDERABAD','Hyd','Hydrabad'],\n",
    "    'Pune':      ['Pune','pune','PUNE','Poona','pune ']\n",
    "}\n",
    "CITY_W = {'Mumbai':25,'Delhi':22,'Bangalore':20,'Chennai':13,'Hyderabad':12,'Pune':8}\n",
    "\n",
    "GENDER_V = {\n",
    "    'Male':   ['Male','male','MALE','M','m','1'],\n",
    "    'Female': ['Female','female','FEMALE','F','f','2']\n",
    "}\n",
    "\n",
    "SEGMENT_V = {\n",
    "    'Premium': ['Premium','premium','PREMIUM','VIP'],\n",
    "    'Regular': ['Regular','regular','REGULAR','Standard'],\n",
    "    'New':     ['New','new','NEW','Newcomer'],\n",
    "    'At-Risk': ['At-Risk','at-risk','AT-RISK','AtRisk'],\n",
    "    'Churned': ['Churned','churned','CHURNED','Inactive']\n",
    "}\n",
    "SEG_W = [12,38,28,14,8]\n",
    "\n",
    "SOURCE_V = {\n",
    "    'App':          ['App','app','APP','Mobile App'],\n",
    "    'Website':      ['Website','website','WEBSITE','Web'],\n",
    "    'Referral':     ['Referral','referral','REFERRAL','Refer'],\n",
    "    'Instagram Ad': ['Instagram Ad','instagram ad','Insta Ad'],\n",
    "    'Google Ad':    ['Google Ad','google ad','Google'],\n",
    "    'Organic':      ['Organic','organic','Direct']\n",
    "}\n",
    "SRC_W = [30,20,15,15,12,8]\n",
    "\n",
    "CATS = ['Electronics','Fashion','Home & Kitchen','Beauty']\n",
    "MISSING = [None,np.nan,'NA','N/A','','null','NULL','-']\n",
    "\n",
    "def rdate(s,e):\n",
    "    return s + timedelta(days=random.randint(0,(e-s).days))\n",
    "\n",
    "def messy_dt(dt):\n",
    "    return dt.strftime(random.choice(['%Y-%m-%d','%d/%m/%Y','%d-%m-%Y','%m/%d/%Y']))\n",
    "\n",
    "def phone():\n",
    "    opts = [f\"9{random.randint(100000000,999999999)}\",\n",
    "            f\"8{random.randint(100000000,999999999)}\",\n",
    "            f\"+91-9{random.randint(100000000,999999999)}\",\n",
    "            '0000000000','123','XXXXXXXXXX',None]\n",
    "    return random.choices(opts,weights=[35,20,15,8,7,7,8])[0]\n",
    "\n",
    "def email(name,cid):\n",
    "    fn = name.split()[0].lower()\n",
    "    opts = [f\"{fn}{cid}@gmail.com\",f\"{fn}.kz@yahoo.co.in\",\n",
    "            f\"{fn}gmail.com\",f\"{fn}@\",None,'NA','']\n",
    "    return random.choices(opts,weights=[45,15,8,7,12,7,6])[0]\n",
    "\n",
    "def age(seg):\n",
    "    base = {'Premium':38,'New':27,'At-Risk':35,'Churned':40,'Regular':32}\n",
    "    b = int(np.random.normal(base.get(seg,32),9))\n",
    "    b = max(18,min(65,b))\n",
    "    return random.choices([b,float(b),str(b),0,-random.randint(1,20),random.randint(120,200),None],\n",
    "                          weights=[60,8,8,6,6,6,6])[0]\n",
    "\n",
    "def loyalty(seg):\n",
    "    # Concern 4: noisy overlap between segments\n",
    "    ranges = {'Premium':(55,100),'Regular':(30,85),'New':(10,55),\n",
    "              'At-Risk':(5,50),'Churned':(1,35)}\n",
    "    lo,hi = ranges[seg]\n",
    "    s = random.randint(lo,hi)\n",
    "    return random.choices([s,float(s),str(s),None],weights=[65,10,15,10])[0]\n",
    "\n",
    "def pref_cat(gender):\n",
    "    # Concern 5: mild gender weighting\n",
    "    w = [25,32,20,23] if gender=='Female' else [42,22,22,14]\n",
    "    c = random.choices(CATS,weights=w)[0]\n",
    "    return random.choices([c,c.lower(),c.upper(),None,'NA'],weights=[65,8,8,12,7])[0]\n",
    "\n",
    "print(\"\\n  Generating 1000 customer records...\")\n",
    "rows = []\n",
    "today = datetime.now()\n",
    "\n",
    "for i in range(1001,2001):\n",
    "    cid = f'C{i}'\n",
    "    name = f\"{random.choice(FIRST)} {random.choice(LAST)}\"\n",
    "    name_fmt = random.choices([name,name.upper(),name.lower(),f\"  {name}\",f\"MR. {name}\"],\n",
    "                               weights=[55,10,10,15,10])[0]\n",
    "\n",
    "    seg_key = random.choices(list(SEGMENT_V.keys()),weights=SEG_W)[0]\n",
    "    seg_val = random.choice(SEGMENT_V[seg_key])\n",
    "\n",
    "    g_key = random.choices(['Male','Female'],weights=[47,53])[0]\n",
    "    g_val = random.choice(GENDER_V[g_key])\n",
    "\n",
    "    city_key = random.choices(list(CITY_W.keys()),weights=list(CITY_W.values()))[0]\n",
    "    city_val = random.choice(CITY_VARIANTS[city_key])\n",
    "    if random.random()<0.06: city_val = random.choice(MISSING[:4])\n",
    "    state,region = CITY_STATE[city_key]\n",
    "\n",
    "    # Registration date — segment drives pattern\n",
    "    if seg_key=='Premium':      reg = rdate(datetime(2020,1,1),datetime(2021,12,31))\n",
    "    elif seg_key in ['Churned','At-Risk']: reg = rdate(datetime(2020,1,1),datetime(2022,6,30))\n",
    "    elif seg_key=='New':        reg = rdate(datetime(2023,1,1),datetime(2024,12,31))\n",
    "    else:                       reg = rdate(datetime(2020,1,1),datetime(2024,12,31))\n",
    "\n",
    "    # Last login — churn pattern\n",
    "    if seg_key=='Churned':      ll = rdate(datetime(2022,1,1),datetime(2023,6,30))\n",
    "    elif seg_key=='At-Risk':    ll = rdate(datetime(2023,1,1),datetime(2024,3,31))\n",
    "    elif seg_key=='Premium':    ll = rdate(datetime(2024,6,1),datetime(2024,12,31))\n",
    "    else:                       ll = rdate(datetime(2023,6,1),datetime(2024,12,31))\n",
    "\n",
    "    lo = ll - timedelta(days=random.randint(0,30))\n",
    "\n",
    "    src_key = random.choices(list(SOURCE_V.keys()),weights=SRC_W)[0]\n",
    "    src_val = random.choice(SOURCE_V[src_key])\n",
    "    if random.random()<0.07: src_val = random.choice(MISSING[:4])\n",
    "\n",
    "    rows.append({\n",
    "        'Customer_ID':          cid,\n",
    "        'Customer_Name':        name_fmt,\n",
    "        'Age':                  age(seg_key),\n",
    "        'Gender':               g_val,\n",
    "        'City':                 city_val,\n",
    "        'State':                random.choices([state,state.lower(),None],weights=[80,10,10])[0],\n",
    "        'Region':               random.choices([region,region.lower(),None],weights=[80,10,10])[0],\n",
    "        'Customer_Segment':     seg_val,\n",
    "        'Registration_Date':    messy_dt(reg),\n",
    "        'Registration_Source':  src_val,\n",
    "        'Last_Login_Date':      random.choices([messy_dt(ll),None,'NA'],weights=[80,12,8])[0],\n",
    "        'Last_Order_Date':      random.choices([messy_dt(lo),None,'NA'],weights=[78,14,8])[0],\n",
    "        'Email':                email(name,i),\n",
    "        'Phone':                phone(),\n",
    "        'Loyalty_Score':        loyalty(seg_key),\n",
    "        'Preferred_Category':   pref_cat(g_key),\n",
    "        'Newsletter_Subscribed':random.choices(\n",
    "            ['Yes','No','yes','no',True,False,1,0,None],\n",
    "            weights=[30,30,8,8,4,4,3,3,10])[0]\n",
    "    })\n",
    "\n",
    "df = pd.DataFrame(rows)\n",
    "dupes  = df.sample(20,random_state=42)\n",
    "blanks = pd.DataFrame([{c:None for c in df.columns} for _ in range(15)])\n",
    "df = pd.concat([df,dupes,blanks],ignore_index=True)\n",
    "df.to_csv('KartZone_Customers.csv',index=False)\n",
    "\n",
    "print(f\"\\n  Rows: {len(df):,} | Cols: {len(df.columns)} | Nulls: {df.isnull().sum().sum():,} | Dupes: {df.duplicated().sum()}\")\n",
    "print(f\"  Saved → KartZone_Customers.csv ✓\")"
   ]
  },
